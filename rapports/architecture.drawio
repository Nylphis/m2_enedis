<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Architecture DPE Lyon">
    <mxGraphModel dx="900" dy="440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ademe" value="&lt;b&gt;API ADEME&lt;/b&gt;&lt;br&gt;DPE logements existants&lt;br&gt;17 codes postaux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actions" value="&lt;b&gt;GitHub Actions&lt;/b&gt; (refresh.yml)&lt;br&gt;fetch, clean, train (option)&lt;br&gt;mensuel (cron) ou manuel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="depot" value="&lt;b&gt;Dépôt GitHub (main)&lt;/b&gt;&lt;br&gt;code, data/processed/,&lt;br&gt;models/ (.joblib, metadata.json)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="610" y="30" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="render" value="&lt;b&gt;Render&lt;/b&gt; : 2 services, même image Docker" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=bottom;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="170" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="appli" value="&lt;b&gt;Appli Streamlit&lt;/b&gt; (app.py, vues/)&lt;br&gt;Contexte, Exploration,&lt;br&gt;Prédiction, Administration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="205" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API FastAPI&lt;/b&gt; (api/main.py)&lt;br&gt;POST /predict, GET /info, /docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="310" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="particulier" value="Particulier&lt;br&gt;(navigateur)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="215" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="client" value="Application cliente&lt;br&gt;(requêtes HTTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="315" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="téléchargement&lt;br&gt;(incrémental ou complet)" style="edgeStyle=none;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="ademe" target="actions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="commit des&lt;br&gt;fichiers modifiés" style="edgeStyle=none;html=1;endArrow=classic;fontSize=11;" edge="1" parent="1" source="actions" target="depot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="redéploiement automatique" style="edgeStyle=none;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="depot" target="render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="lancement manuel&lt;br&gt;(API GitHub)" style="edgeStyle=none;html=1;endArrow=classic;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=0;entryX=0.65;entryY=1;" edge="1" parent="1" source="appli" target="actions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="formulaire, graphiques" style="edgeStyle=none;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="particulier" target="appli">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="JSON" style="edgeStyle=none;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
